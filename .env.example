# Copy to .env and adjust. Values already set in the shell take precedence over this file.

# Port for the API and web page.
PORT=3000

# Word list files, one word per line. Paths are relative to the project root.
ANSWERS_PATH=data/answers.txt
ALLOWED_PATH=data/allowed.txt

# Set to 1 to let POST /api/games accept {"answer": "crane"} (for demos and testing). Leave empty otherwise.
ALLOW_FIXED_ANSWER=

# "production" serves the built page from dist/web (run `npm run build` first); anything else uses Vite dev mode.
# `npm start` sets this for you.
NODE_ENV=development

{
  "name": "wordle-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Play Wordle in the browser with an entropy-based solver that suggests and explains the next guess.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --ignore 'src/web/**' src/server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "SKIP_SLOW=1 vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.1.0",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.12",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
